# Monitoring target
TARGET_URL=https://examweb.ggsipu.ac.in/web/login.jsp
CHECK_INTERVAL_MS=60000
TIMEOUT_MS=10000
EXPECT_STATUS=200
# Optional: page content must include this keyword
KEYWORD=
# Minimum time between repeated down alerts (ms)
NOTIFY_COOLDOWN_MS=900000

# Email notifier (enabled by default unless EMAIL_ENABLED=false)
EMAIL_ENABLED=true
EMAIL_TO=recipient@example.com
EMAIL_FROM=alerts@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password

# WhatsApp notifier via Twilio (opt-in)
WHATSAPP_ENABLED=false
WHATSAPP_TO=+15551234567
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=+15557654321

# Telegram notifier (opt-in)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz123456789
TELEGRAM_CHAT_ID=-1001234567890
